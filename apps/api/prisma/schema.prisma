generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
  LOCKED
}

enum AccessScope {
  SINGLE_BRANCH
  SELECTED_BRANCHES
  COMPANY_WIDE
  PLATFORM_WIDE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PENDING
  POSTED
  PART_PAID
  PAID
  VOID
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum FiscalStatus {
  NOT_REQUIRED
  READY
  PENDING
  SUBMITTED
  FISCALISED
  REJECTED
  RETRY
}

enum FiscalDayStatus {
  CLOSED
  OPEN
  CLOSING
  ERROR
}

enum DeviceStatus {
  UNREGISTERED
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PART_RECEIVED
  RECEIVED
  CANCELLED
}

enum LeadStatus {
  NEW
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  DISPOSED
}

enum RiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

enum IntegrationType {
  ZIMRA
  PAYNOW
  SMTP
  BANK
  WEBHOOK
  SSO
  STORAGE
  SMS
  WHATSAPP
  OTHER
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  active       Boolean       @default(true)
  companies    Company[]
  memberships  Membership[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Company {
  id                        String                          @id @default(uuid())
  tenantId                  String
  tenant                    Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalName                 String
  tradingName               String?
  code                      String
  tin                       String?
  vatNumber                 String?
  baseCurrency              String                          @default("USD")
  financialYearStart        Int                             @default(1)
  active                    Boolean                         @default(true)
  branches                  Branch[]
  memberships               Membership[]
  accounts                  LedgerAccount[]
  journals                  JournalEntry[]
  customers                 Customer[]
  invoices                  SalesInvoice[]
  suppliers                 Supplier[]
  projects                  Project[]
  roles                     Role[]
  approvalWorkflows         ApprovalWorkflow[]
  approvalRequests          ApprovalRequest[]
  financialYears            FinancialYear[]
  fiscalPeriods             FiscalPeriod[]
  bankAccounts              BankAccount[]
  bankReconciliations       BankReconciliation[]
  vendorCredits             VendorCredit[]
  checks                    Check[]
  checkSequences            CheckSequence[]
  creditCardAccounts        CreditCardAccount[]
  creditCardTransactions    CreditCardTransaction[]
  creditCardPayments        CreditCardPayment[]
  creditCardStatements      CreditCardStatement[]
  vendorCreditRefunds       VendorCreditRefund[]
  budgetControlRules        BudgetControlRule[]
  budgetApprovals           BudgetApproval[]
  deliveryNotes             DeliveryNote[]
  inventoryBatches          InventoryBatch[]
  serialNumbers             SerialNumber[]
  assetCategories           AssetCategory[]
  depreciationRuns          DepreciationRun[]
  assetLocations            AssetLocation[]
  currencies                Currency[]
  exchangeRates             ExchangeRate[]
  jobVacancies              JobVacancy[]
  candidates                Candidate[]
  jobApplications           JobApplication[]
  onboardingTemplates       OnboardingTemplate[]
  employeeOnboardings       EmployeeOnboarding[]
  leaveTypes                LeaveType[]
  leavePolicies             LeavePolicy[]
  leaveBalances             LeaveBalance[]
  leaveAccruals             LeaveAccrual[]
  benefitPlans              BenefitPlan[]
  employeeBenefits          EmployeeBenefit[]
  crmStages                 CrmStage[]
  crmEvents                 CrmEvent[]
  priceLists                PriceList[]
  stockReservations         StockReservation[]
  inventoryCategories       InventoryCategory[]
  interviews                Interview[]
  offers                    Offer[]
  recruitmentRequisitions   RecruitmentRequisition[]
  talentPools               TalentPool[]
  assessments               Assessment[]
  candidateDocuments        CandidateDocument[]
  recruitmentActivities     RecruitmentActivity[]
  workCalendars             WorkCalendar[]
  holidays                  Holiday[]
  compensationHistory       CompensationHistory[]
  employmentHistory         EmploymentHistory[]
  performanceCycles         PerformanceCycle[]
  performanceReviews        PerformanceReview[]
  kpiCategories             KpiCategory[]
  kpiTemplates              KpiTemplate[]
  kpiTemplateVersions       KpiTemplateVersion[]
  kpiDefinitions            KpiDefinition[]
  performanceBands          PerformanceBand[]
  performanceAssessments    EmployeePerformanceAssessment[]
  performanceKpis           EmployeePerformanceKpi[]
  performanceQaReviews      PerformanceQaReview[]
  performanceNotifications  PerformanceNotification[]
  performanceIncentives     PerformanceIncentive[]
  developmentPlans          DevelopmentPlan[]
  qaTemplates               QaTemplate[]
  qaAssessments             QaAssessment[]
  incentivePlans            IncentivePlan[]
  employeeIncentives        EmployeeIncentive[]
  serviceTickets            ServiceTicket[]
  debitNotes                DebitNote[]
  documentTemplates         DocumentTemplate[]
  trailEvents               DocumentTrailEvent[]
  emailLogs                 DocumentEmailLog[]
  internalControls          InternalControl[]
  controlTests              ControlTest[]
  controlEvidence           ControlEvidence[]
  auditEngagements          AuditEngagement[]
  auditProcedures           AuditProcedure[]
  auditFindings             AuditFinding[]
  auditActions              AuditAction[]
  regulatoryReports         RegulatoryReport[]
  timesheets                Timesheet[]
  reportDefinitions         ReportDefinition[]
  reportUserStates          ReportUserState[]
  purchaseOrders            PurchaseOrder[]
  items                     InventoryItem[]
  warehouses                Warehouse[]
  employees                 Employee[]
  leads                     Lead[]
  assets                    Asset[]
  risks                     Risk[]
  complianceObligations     ComplianceObligation[]
  auditLogs                 AuditLog[]
  integrations              IntegrationConnection[]
  quotations                Quotation[]
  salesOrders               SalesOrder[]
  receipts                  Receipt[]
  creditNotes               CreditNote[]
  customerReturns           CustomerReturn[]
  supplierReturns           SupplierReturn[]
  requisitions              PurchaseRequisition[]
  goodsReceivedNotes        GoodsReceivedNote[]
  supplierInvoices          SupplierInvoice[]
  supplierPayments          SupplierPayment[]
  stockCounts               StockCount[]
  leaveRequests             LeaveRequest[]
  attendance                Attendance[]
  payrollRuns               PayrollRun[]
  opportunities             Opportunity[]
  tasks                     CrmTask[]
  interactions              CustomerInteraction[]
  maintenanceOrders         MaintenanceOrder[]
  taxRates                  TaxRate[]
  budgets                   Budget[]
  configs                   SystemConfig[]
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  applicationStageHistories ApplicationStageHistory[]
  interviewScorecards       InterviewScorecard[]

  @@unique([tenantId, code])
}

model Branch {
  id                      String                   @id @default(uuid())
  companyId               String
  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  code                    String
  address                 String?
  city                    String?
  managerId               String?
  managerName             String?
  phone                   String?
  email                   String?
  street                  String?
  province                String?
  postalCode              String?
  country                 String?
  defaultCurrency         String                   @default("USD")
  timezone                String?
  active                  Boolean                  @default(true)
  fiscalDevices           FiscalDevice[]
  warehouses              Warehouse[]
  departments             Department[]
  invoices                SalesInvoice[]
  quotations              Quotation[]
  salesOrders             SalesOrder[]
  requisitions            PurchaseRequisition[]
  createdAt               DateTime                 @default(now())
  recruitmentRequisitions RecruitmentRequisition[]
  jobVacancies            JobVacancy[]
  holidays                Holiday[]
  memberships             Membership[]             @relation("MembershipPrimaryBranch")
  membershipBranches      MembershipBranch[]
  auditLogs               AuditLog[]

  @@unique([companyId, code])
}

model Department {
  id                      String                          @id @default(uuid())
  branchId                String
  branch                  Branch                          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name                    String
  code                    String
  employees               Employee[]
  recruitmentRequisitions RecruitmentRequisition[]
  jobVacancies            JobVacancy[]
  offers                  Offer[]
  kpiTemplates            KpiTemplate[]
  performanceAssessments  EmployeePerformanceAssessment[]

  @@unique([branchId, code])
}

model User {
  id                         String                   @id @default(uuid())
  email                      String                   @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  status                     UserStatus               @default(ACTIVE)
  isPlatformAdmin            Boolean                  @default(false)
  employeeId                 String?                  @unique
  employee                   Employee?                @relation(fields: [employeeId], references: [id])
  lastLoginAt                DateTime?
  lastActivityAt             DateTime?
  deactivatedAt              DateTime?
  deactivationReason         String?
  emailVerifiedAt            DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  emailVerificationTokenHash String?
  memberships                Membership[]
  refreshTokens              RefreshToken[]
  mfaMethods                 MfaMethod[]
  trailEvents                DocumentTrailEvent[]
  auditLogs                  AuditLog[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  recruitmentRequisitions    RecruitmentRequisition[]
}

model Membership {
  id              String             @id @default(uuid())
  userId          String
  tenantId        String
  companyId       String
  role            String             @default("ADMIN")
  accessScope     AccessScope        @default(COMPANY_WIDE)
  primaryBranchId String?
  primaryBranch   Branch?            @relation("MembershipPrimaryBranch", fields: [primaryBranchId], references: [id])
  status          MembershipStatus   @default(ACTIVE)
  effectiveFrom   DateTime           @default(now())
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles           MembershipRole[]
  branches        MembershipBranch[]

  @@unique([userId, companyId])
}

model MembershipBranch {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
}

model SubscriptionPlan {
  id            String         @id @default(uuid())
  name          String         @unique
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  maxCompanies  Int            @default(1)
  maxUsers      Int            @default(5)
  features      Json
  subscriptions Subscription[]
}

model Subscription {
  id       String           @id @default(uuid())
  tenantId String           @unique
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  status   String           @default("ACTIVE")
  startsAt DateTime         @default(now())
  endsAt   DateTime?
}

model LedgerAccount {
  id                     String                  @id @default(uuid())
  companyId              String
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  type                   AccountType
  subtype                String?
  customTypeName         String?
  isGroup                Boolean                 @default(false)
  description            String?
  taxCode                String?
  isSystem               Boolean                 @default(false)
  parentId               String?
  active                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  lines                  JournalLine[]
  budgets                Budget[]
  bankAccounts           BankAccount[]
  checkAllocations       CheckAllocation[]
  creditCardAccounts     CreditCardAccount[]
  creditCardTransactions CreditCardTransaction[]
  budgetControlRules     BudgetControlRule[]

  @@unique([companyId, code])
}

// System-controlled canonical accounting classes may be extended by custom
// "display" account types, each mapped to a canonical class so financial
// statements (Balance Sheet / P&L / Trial Balance) stay intact.
model AccountTypeConfig {
  id             String      @id @default(uuid())
  companyId      String
  name           String
  canonicalClass AccountType
  normalBalance  String      @default("DEBIT")
  description    String?
  isSystem       Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

// Flexible business-specific sub-classifications. Sub-types are the safe place
// for custom accounting classification (unlike top-level Account Type, which is
// controlled by `canonicalClass`).
model AccountSubtype {
  id             String      @id @default(uuid())
  companyId      String
  canonicalClass AccountType
  name           String
  reportingGroup String?
  normalBalance  String?
  description    String?
  isSystem       Boolean     @default(false)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@unique([companyId, canonicalClass, name])
  @@index([companyId, canonicalClass])
}

// ---------------------------------------------------------------------------
// External Bank Connection & Bank Feed (read-only data ingestion layer).
// Bank data is NEVER written directly to the General Ledger â€” it is staged here
// and then matched / user-processed through the normal accounting engine.
// ---------------------------------------------------------------------------
model BankConnection {
  id                   String    @id @default(uuid())
  tenantId             String
  companyId            String
  provider             String
  providerConnectionId String?
  institutionId        String?
  institutionName      String?
  status               String    @default("CONNECTED")
  accessTokenCipher    String?
  refreshTokenCipher   String?
  tokenExpiresAt       DateTime?
  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSyncError        String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([tenantId, companyId])
}

model ExternalBankAccount {
  id                    String    @id @default(uuid())
  tenantId              String
  companyId             String
  bankConnectionId      String
  providerAccountId     String
  institutionName       String?
  accountName           String?
  accountType           String?
  accountSubtype        String?
  maskedAccountNumber   String?
  currency              String    @default("USD")
  currentBalance        Decimal   @default(0) @db.Decimal(18, 2)
  availableBalance      Decimal   @default(0) @db.Decimal(18, 2)
  balanceUpdatedAt      DateTime?
  enabled               Boolean   @default(true)
  nexusBankAccountId    String?
  glAccountId           String?
  lastTransactionSyncAt DateTime?
  createdAt             DateTime  @default(now())

  @@unique([companyId, providerAccountId])
  @@index([tenantId, companyId])
}

model BankTransaction {
  id                        String    @id @default(uuid())
  tenantId                  String
  companyId                 String
  bankConnectionId          String
  externalAccountId         String
  providerTransactionId     String
  bookingDate               DateTime?
  valueDate                 DateTime?
  amount                    Decimal   @db.Decimal(18, 2)
  currency                  String    @default("USD")
  direction                 String
  description               String?
  reference                 String?
  bankReference             String?
  counterpartyName          String?
  counterpartyAccountMasked String?
  providerType              String?
  providerStatus            String    @default("POSTED")
  runningBalance            Decimal?  @db.Decimal(18, 2)
  rawMetadata               Json?
  matchStatus               String    @default("UNMATCHED")
  firstSeenAt               DateTime  @default(now())
  lastSeenAt                DateTime  @default(now())

  @@unique([externalAccountId, providerTransactionId])
  @@index([companyId, externalAccountId])
}

model JournalEntry {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number      String
  date        DateTime
  reference   String?
  description String
  createdById String?
  sourceType  String
  sourceId    String?
  status      JournalStatus @default(POSTED)
  lines       JournalLine[]
  createdAt   DateTime      @default(now())

  @@unique([companyId, number])
  @@unique([companyId, sourceType, sourceId])
}

model JournalLine {
  id          String        @id @default(uuid())
  journalId   String
  journal     JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId   String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  description String?
  debit       Decimal       @default(0) @db.Decimal(18, 2)
  credit      Decimal       @default(0) @db.Decimal(18, 2)
}

model Customer {
  id             String                @id @default(uuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String
  name           String
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  mobile         String?
  address1       String?
  address2       String?
  city           String?
  state          String?
  zip            String?
  country        String?
  notes          String?
  taxStatus      String                @default("Taxable")
  defaultTaxRate Decimal               @default(0) @db.Decimal(8, 4)
  tin            String?
  vatNumber      String?
  creditLimit    Decimal               @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  status         String                @default("ACTIVE")
  priceListId    String?
  invoices       SalesInvoice[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  creditNotes    CreditNote[]
  customerReturns CustomerReturn[]
  interactions   CustomerInteraction[]
  opportunities  Opportunity[]
  receipts       Receipt[]
  projects       Project[]
  deliveryNotes  DeliveryNote[]
  serviceTickets ServiceTicket[]
  debitNotes     DebitNote[]
  convertedLeads Lead[]                @relation("LeadConversions")
  crmEvents      CrmEvent[]

  @@unique([companyId, code])
}

model SalesInvoice {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id])
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id])
  invoiceNo          String
  invoiceDate        DateTime            @default(now())
  terms              String?
  billingAddress     String?
  notes              String?
  statementMemo      String?
  email              String?
  customerReference  String?
  poReference        String?
  salesperson        String?
  dueDate            DateTime?
  currency           String              @default("USD")
  exchangeRate       Decimal             @default(1) @db.Decimal(18, 6)
  subtotal           Decimal             @db.Decimal(18, 2)
  taxTotal           Decimal             @db.Decimal(18, 2)
  total              Decimal             @db.Decimal(18, 2)
  status             InvoiceStatus       @default(DRAFT)
  invoiceStatus      String              @default("DRAFT")
  paymentStatus      PaymentStatus       @default(UNPAID)
  amountPaid         Decimal             @default(0) @db.Decimal(18, 2)
  creditsApplied     Decimal             @default(0) @db.Decimal(18, 2)
  balanceDue         Decimal             @default(0) @db.Decimal(18, 2)
  fiscalRequired     Boolean             @default(true)
  fiscalStatus       FiscalStatus        @default(READY)
  projectId          String?
  project            Project?            @relation(fields: [projectId], references: [id])
  sourceQuoteId      String?
  sourceQuote        Quotation?          @relation("InvoiceFromQuote", fields: [sourceQuoteId], references: [id])
  sourceSalesOrderId String?
  sourceSalesOrder   SalesOrder?         @relation("InvoicesFromOrder", fields: [sourceSalesOrderId], references: [id])
  lines              SalesInvoiceLine[]
  fiscalReceipt      FiscalReceipt?
  receipts           Receipt[]
  creditNotes        CreditNote[]
  customerReturns    CustomerReturn[]
  debitNotes         DebitNote[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  paymentAllocations PaymentAllocation[]
  deliveryNotes      DeliveryNote[]
  stockIssuedAt      DateTime?

  @@unique([companyId, invoiceNo])
}

model SalesInvoiceLine {
  id               String          @id @default(uuid())
  invoiceId        String
  invoice          SalesInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  salesOrderLineId String?
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id])
  description      String
  itemId           String?
  quantity         Decimal         @db.Decimal(18, 4)
  unitPrice        Decimal         @db.Decimal(18, 2)
  taxRate          Decimal         @default(0) @db.Decimal(8, 4)
  taxAmount        Decimal         @default(0) @db.Decimal(18, 2)
  lineTotal        Decimal         @db.Decimal(18, 2)
  hsCode           String?
}

model Supplier {
  id                     String              @id @default(uuid())
  companyId              String
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  firstName              String?
  lastName               String?
  companyName            String?
  email                  String?
  phone                  String?
  mobile                 String?
  website                String?
  status                 String              @default("ACTIVE")
  vendorType             String?
  contactName            String?
  jobTitle               String?
  address1               String?
  address2               String?
  city                   String?
  state                  String?
  zip                    String?
  country                String?
  billingAddress1        String?
  billingAddress2        String?
  billingCity            String?
  tin                    String?
  vatRegistered          Boolean             @default(false)
  vatNumber              String?
  withholdingTaxType     String?
  withholdingTaxRate     Decimal?            @db.Decimal(8, 4)
  companyRegNo           String?
  paymentTerms           String?
  currency               String              @default("USD")
  paymentMethod          String?
  leadTimeDays           Int?
  minimumOrderValue      Decimal?            @db.Decimal(18, 2)
  defaultBuyer           String?
  defaultBranchId        String?
  defaultWarehouseId     String?
  defaultProjectId       String?
  defaultExpenseCategory String?
  accountNumber          String?
  openingBalance         Decimal             @default(0) @db.Decimal(18, 2)
  creditLimit            Decimal?            @db.Decimal(18, 2)
  preferred              Boolean             @default(false)
  rating                 Int?
  complianceStatus       String?
  contractStart          DateTime?
  contractEnd            DateTime?
  bankName               String?
  bankAccountName        String?
  bankBranch             String?
  bankCode               String?
  swift                  String?
  iban                   String?
  mobileMoneyProvider    String?
  mobileMoneyNumber      String?
  notes                  String?
  orders                 PurchaseOrder[]
  goodsReceivedNotes     GoodsReceivedNote[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]
  vendorCredits          VendorCredit[]
  supplierReturns        SupplierReturn[]

  @@unique([companyId, code])
}

model PurchaseOrder {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  requisitionId      String?
  poNo               String
  orderDate          DateTime            @default(now())
  expectedDate       DateTime?
  status             PurchaseOrderStatus @default(DRAFT)
  receiptStatus      String              @default("NOT_RECEIVED")
  billingStatus      String              @default("NOT_BILLED")
  currency           String              @default("USD")
  paymentTerms       String?
  supplierReference  String?
  shipTo             String?
  memo               String?
  subtotal           Decimal             @default(0) @db.Decimal(18, 2)
  discount           Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(18, 2)
  total              Decimal             @db.Decimal(18, 2)
  lines              PurchaseOrderLine[]
  goodsReceivedNotes GoodsReceivedNote[]
  supplierInvoices   SupplierInvoice[]
  payments           SupplierPayment[]
  supplierReturns    SupplierReturn[]
  createdAt          DateTime            @default(now())

  @@unique([companyId, poNo])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  itemId          String?
  quantity        Decimal       @db.Decimal(18, 4)
  unitPrice       Decimal       @db.Decimal(18, 2)
  lineTotal       Decimal       @db.Decimal(18, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 4)
  invoicedQty     Decimal       @default(0) @db.Decimal(18, 4)
}

model InventoryItem {
  id                      String             @id @default(uuid())
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sku                     String
  name                    String
  unit                    String             @default("EA")
  hsCode                  String?
  barcode                 String?
  brand                   String?
  description             String?
  salesDescription        String?
  purchaseDescription     String?
  /// INVENTORY_PRODUCT | NON_INVENTORY_PRODUCT | SERVICE
  type                    String             @default("INVENTORY_PRODUCT")
  itemCategory            String?
  categoryId              String?
  category                InventoryCategory? @relation(fields: [categoryId], references: [id])
  imageUrl                String?
  reorderLevel            Decimal            @default(0) @db.Decimal(18, 4)
  reorderQuantity         Decimal            @default(0) @db.Decimal(18, 4)
  safetyStock             Decimal            @default(0) @db.Decimal(18, 4)
  sellingPrice            Decimal            @default(0) @db.Decimal(18, 2)
  minSellingPrice         Decimal?           @db.Decimal(18, 2)
  purchaseCost            Decimal            @default(0) @db.Decimal(18, 2)
  costingMethod           String?
  trackBatch              Boolean            @default(false)
  trackSerial             Boolean            @default(false)
  trackExpiry             Boolean            @default(false)
  salesTaxCode            String?
  purchaseTaxCode         String?
  incomeAccountId         String?
  cogsAccountId           String?
  inventoryAssetAccountId String?
  expenseAccountId        String?
  adjustmentAccountId     String?
  defaultWarehouseId      String?
  preferredSupplierId     String?
  supplierSku             String?
  leadTimeDays            Int?
  allowDiscount           Boolean            @default(true)
  active                  Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt
  movements               StockMovement[]
  batches                 InventoryBatch[]
  serials                 SerialNumber[]
  reservations            StockReservation[]
  priceListItems          PriceListItem[]

  @@unique([companyId, sku])
}

model InventoryCategory {
  id                      String              @id @default(uuid())
  companyId               String
  company                 Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  code                    String?
  parentId                String?
  parent                  InventoryCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children                InventoryCategory[] @relation("CategoryTree")
  description             String?
  active                  Boolean             @default(true)
  incomeAccountId         String?
  cogsAccountId           String?
  inventoryAssetAccountId String?
  expenseAccountId        String?
  salesTaxCode            String?
  purchaseTaxCode         String?
  items                   InventoryItem[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id])
  code               String
  name               String
  movements          StockMovement[]
  stockCounts        StockCount[]
  goodsReceivedNotes GoodsReceivedNote[]
  batches            InventoryBatch[]
  serials            SerialNumber[]
  customerReturns    CustomerReturn[]
  supplierReturns    SupplierReturn[]

  @@unique([companyId, code])
}

model StockMovement {
  id          String            @id @default(uuid())
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  itemId      String
  item        InventoryItem     @relation(fields: [itemId], references: [id])
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id])
  type           StockMovementType
  quantity       Decimal           @db.Decimal(18, 4)
  signedQuantity Decimal           @default(0) @db.Decimal(18, 4)
  unitCost       Decimal           @default(0) @db.Decimal(18, 4)
  reference      String?
  notes          String?
  batchNo        String?
  serialNo       String?
  occurredAt     DateTime          @default(now())
}

model StockReservation {
  id           String        @id @default(uuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId  String?
  salesOrderId String?
  referencedBy String?
  qty          Decimal       @default(0) @db.Decimal(18, 4)
  status       String        @default("ACTIVE")
  releasedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([itemId])
  @@index([salesOrderId])
}

model PriceList {
  id            String          @id @default(uuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  currency      String          @default("USD")
  active        Boolean         @default(true)
  customerGroup String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  items         PriceListItem[]
  createdAt     DateTime        @default(now())

  @@unique([companyId, name])
}

model PriceListItem {
  id          String        @id @default(uuid())
  priceListId String
  priceList   PriceList     @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price       Decimal       @default(0) @db.Decimal(18, 2)
  minQty      Decimal?      @db.Decimal(18, 4)

  @@unique([priceListId, itemId])
}

model Employee {
  id                     String                          @id @default(uuid())
  companyId              String
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId           String?
  department             Department?                     @relation(fields: [departmentId], references: [id])
  employeeNo             String
  firstName              String
  lastName               String
  middleName             String?
  preferredName          String?
  email                  String?
  workEmail              String?
  personalEmail          String?
  phone                  String?
  mobile                 String?
  hireDate               DateTime
  dateOfBirth            DateTime?
  gender                 String?
  idType                 String?
  idNumber               String?
  nationality            String?
  addressLine1           String?
  addressLine2           String?
  city                   String?
  province               String?
  postalCode             String?
  country                String?
  basicSalary            Decimal                         @default(0) @db.Decimal(18, 2)
  currency               String                          @default("USD")
  allowances             Json?
  deductions             Json?
  active                 Boolean                         @default(true)
  managerId              String?
  position               String?
  contractType           String?
  workCalendarId         String?
  workCalendar           WorkCalendar?                   @relation(fields: [workCalendarId], references: [id])
  employmentStatus       String?                         @default("ACTIVE")
  probationEndDate       DateTime?
  contractEndDate        DateTime?
  payFrequency           String                          @default("MONTHLY")
  compensationType       String                          @default("SALARIED")
  bankDetails            Json?
  taxDetails             Json?
  emergencyContact       Json?
  documents              Json?
  status                 String                          @default("ACTIVE")
  leaveRequests          LeaveRequest[]
  attendance             Attendance[]
  payslips               Payslip[]
  onboarding             EmployeeOnboarding?
  leaveBalances          LeaveBalance[]
  employeeBenefits       EmployeeBenefit[]
  timesheets             Timesheet[]
  reqHiringManaged       RecruitmentRequisition[]        @relation("ReqHiringManager")
  reqRequested           RecruitmentRequisition[]        @relation("ReqRequestedBy")
  vacancyHiring          JobVacancy[]                    @relation("VacancyHiringManager")
  vacancyRecruiting      JobVacancy[]                    @relation("VacancyRecruiter")
  ownedApplications      JobApplication[]                @relation("ApplicationOwner")
  scorecards             InterviewScorecard[]            @relation("ScorecardReviewer")
  hiredCandidate         Candidate[]                     @relation("CandidateEmployee")
  compensationHistory    CompensationHistory[]
  employmentHistory      EmploymentHistory[]
  performanceReviews     PerformanceReview[]
  performanceAssessments EmployeePerformanceAssessment[]
  performanceIncentives  PerformanceIncentive[]
  developmentPlans       DevelopmentPlan[]
  qaAssessments          QaAssessment[]
  leaveApprovals         LeaveRequest[]                  @relation("LeaveApprover")
  offerManaged           Offer[]
  incentives             EmployeeIncentive[]
  user                   User?

  @@unique([companyId, employeeNo])
}

model WorkCalendar {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  weekendDays    Json? // e.g. ["SATURDAY","SUNDAY"]
  scheduledStart String?        @default("08:00")
  scheduledEnd   String?        @default("17:00")
  breakMinutes   Int            @default(60)
  active         Boolean        @default(true)
  employees      Employee[]
  leaveRequests  LeaveRequest[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Holiday {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  name      String
  date      DateTime
  country   String?
  region    String?
  recurring Boolean  @default(false)
  active    Boolean  @default(true)

  @@index([companyId])
  @@index([companyId, date])
}

model CompensationHistory {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate    DateTime
  baseSalary       Decimal  @db.Decimal(18, 2)
  currency         String   @default("USD")
  payFrequency     String   @default("MONTHLY")
  compensationType String   @default("SALARIED")
  reason           String?
  approvedById     String?
  createdAt        DateTime @default(now())

  @@index([employeeId])
  @@index([companyId])
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveDate DateTime
  changeType    String
  field         String?
  previousValue String?
  newValue      String?
  reason        String?
  changedById   String?
  createdAt     DateTime @default(now())

  @@index([employeeId])
  @@index([companyId])
}

model PerformanceCycle {
  id               String                          @id @default(uuid())
  companyId        String
  company          Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  cycleType        String                          @default("QUARTERLY") // MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL | PROBATION | CUSTOM
  description      String?
  periodType       String                          @default("QUARTERLY") // legacy column kept for old reviews
  periodStart      DateTime
  periodEnd        DateTime
  submissionOpens  DateTime
  employeeDeadline DateTime
  managerDeadline  DateTime
  qaDeadline       DateTime?
  approvalDeadline DateTime?
  includeNewHires  String                          @default("NO") // NO | YES | PRORATED
  departmentIds    Json? // restrict cycle to departments (null = all)
  employeeIds      Json? // explicit employee list override
  status           String                          @default("DRAFT") // DRAFT | SCHEDULED | OPEN | EMPLOYEE_SUBMISSION | MANAGER_REVIEW | QA_REVIEW | CALIBRATION | APPROVAL | COMPLETED | LOCKED
  openedAt         DateTime?
  completedAt      DateTime?
  lockedAt         DateTime?
  startDate        DateTime // legacy column kept for old reviews
  endDate          DateTime // legacy column kept for old reviews
  reviews          PerformanceReview[]
  assessments      EmployeePerformanceAssessment[]
  createdBy        String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([companyId])
  @@index([companyId, status])
}

model PerformanceReview {
  id            String            @id @default(uuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId       String?
  cycle         PerformanceCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId    String?
  status        String            @default("OPEN")
  selfReview    Json?
  managerReview Json?
  goals         Json?
  overallRating Decimal?          @db.Decimal(4, 2)
  calibration   String?
  comments      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([cycleId])
  @@index([employeeId])
  @@index([companyId])
}

model QaTemplate {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  departmentId  String?
  jobRole       String?
  frequency     String         @default("MONTHLY")
  passThreshold Decimal        @default(70) @db.Decimal(5, 2)
  criteria      Json?
  active        Boolean        @default(true)
  assessments   QaAssessment[]

  @@index([companyId])
}

model QaAssessment {
  id                String      @id @default(uuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId        String?
  template          QaTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId        String?
  workReference     String?
  scores            Json?
  overallScore      Decimal?    @db.Decimal(5, 2)
  findings          String?
  comments          String?
  correctiveActions String?
  createdAt         DateTime    @default(now())

  @@index([employeeId])
  @@index([companyId])
}

model IncentivePlan {
  id                    String                 @id @default(uuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  eligibility           String?
  departmentId          String?
  threshold             Decimal?               @db.Decimal(12, 2)
  calculation           Json?
  maxPayout             Decimal?               @db.Decimal(12, 2)
  payrollComponent      String?
  status                String                 @default("ACTIVE")
  incentives            EmployeeIncentive[]
  performanceIncentives PerformanceIncentive[]

  @@index([companyId])
}

model EmployeeIncentive {
  id           String         @id @default(uuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId       String?
  plan         IncentivePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period       String?
  amount       Decimal        @db.Decimal(12, 2)
  status       String         @default("PROPOSED")
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime       @default(now())

  @@index([employeeId])
  @@index([companyId])
}

// ============================= Performance Management (KPI) =============================

model KpiCategory {
  id             String          @id @default(uuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  color          String?
  active         Boolean         @default(true)
  kpiDefinitions KpiDefinition[]
  createdAt      DateTime        @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model KpiTemplate {
  id                String               @id @default(uuid())
  companyId         String
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId      String
  department        Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  jobRole           String? // matches Employee.position (role-specific override when set)
  name              String
  description       String?
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  passMark          Decimal              @default(70) @db.Decimal(5, 2)
  maxAchievement    Decimal              @default(120) @db.Decimal(5, 2)
  criticalMin       Decimal?             @db.Decimal(5, 2)
  selfAssessment    Boolean              @default(false)
  qaRequired        Boolean              @default(true)
  managerQaDistinct Boolean              @default(true)
  status            String               @default("DRAFT") // DRAFT | ACTIVE | INACTIVE | ARCHIVED
  currentVersion    Int                  @default(1)
  versions          KpiTemplateVersion[]
  createdBy         String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([companyId])
  @@index([companyId, departmentId])
}

model KpiTemplateVersion {
  id             String                          @id @default(uuid())
  companyId      String
  company        Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId     String
  template       KpiTemplate                     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version        Int
  name           String
  description    String?
  passMark       Decimal                         @default(70) @db.Decimal(5, 2)
  maxAchievement Decimal                         @default(120) @db.Decimal(5, 2)
  criticalMin    Decimal?                        @db.Decimal(5, 2)
  selfAssessment Boolean                         @default(false)
  qaRequired     Boolean                         @default(true)
  status         String                          @default("ACTIVE") // ACTIVE | SUPERSEDED | ARCHIVED
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  kpis           KpiDefinition[]
  assessments    EmployeePerformanceAssessment[]

  @@unique([templateId, version])
  @@index([companyId])
}

model KpiDefinition {
  id                      String             @id @default(uuid())
  companyId               String
  company                 Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  versionId               String
  version                 KpiTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  code                    String
  name                    String
  description             String
  categoryId              String?
  category                KpiCategory?       @relation(fields: [categoryId], references: [id])
  categoryLabel           String? // fallback display when category row removed
  weight                  Decimal            @db.Decimal(5, 2)
  measurementType         String             @default("NUMBER") // NUMBER | PERCENTAGE | CURRENCY | COUNT | DAYS | HOURS | RATING_SCALE | YES_NO | MANUAL_SCORE | SYSTEM_METRIC
  direction               String             @default("HIGHER_IS_BETTER") // HIGHER_IS_BETTER | LOWER_IS_BETTER | TARGET_RANGE | PASS_FAIL
  targetType              String             @default("NUMBER") // NUMBER | PERCENT | CURRENCY | COUNT | DAYS | HOURS | RATING | YES | NO
  targetValue             Decimal?           @db.Decimal(18, 4)
  targetText              String? // for YES_NO / PASS_FAIL / descriptive targets
  unit                    String?
  dataSource              String? // SYSTEM source key e.g. SALES_POSTED, ATTENDANCE_PCT ...
  dataSourceLabel         String?
  scoringMethod           String             @default("PROPORTIONAL") // PROPORTIONAL | PASS_FAIL | RATING | BINARY
  minimumAcceptable       Decimal?           @db.Decimal(18, 4)
  stretchTarget           Decimal?           @db.Decimal(18, 4)
  evidenceRequired        Boolean            @default(false)
  employeeCommentRequired Boolean            @default(false)
  reviewerCommentRequired Boolean            @default(false)
  critical                Boolean            @default(false)
  position                Int                @default(0)

  @@index([versionId])
  @@index([companyId])
}

model PerformanceBand {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  templateId String? // optional: template-specific bands override company bands
  minScore   Decimal @db.Decimal(5, 2)
  maxScore   Decimal @db.Decimal(5, 2)
  label      String
  color      String?
  position   Int     @default(0)

  @@index([companyId])
}

model EmployeePerformanceAssessment {
  id                        String                   @id @default(uuid())
  companyId                 String
  company                   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId                   String
  cycle                     PerformanceCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId                String
  employee                  Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departmentId              String?
  department                Department?              @relation(fields: [departmentId], references: [id])
  managerId                 String?
  versionId                 String
  version                   KpiTemplateVersion       @relation(fields: [versionId], references: [id])
  templateName              String // snapshot of template name for reporting
  status                    String                   @default("PENDING_EMPLOYEE") // PENDING_EMPLOYEE | PENDING_MANAGER | PENDING_QA | PENDING_CALIBRATION | PENDING_APPROVAL | APPROVED | COMPLETED | LOCKED
  employeeSubmittedAt       DateTime?
  managerSubmittedAt        DateTime?
  qaSubmittedAt             DateTime?
  approvedAt                DateTime?
  lockedAt                  DateTime?
  totalScore                Decimal?                 @db.Decimal(6, 2) // 0-100+ weighted percentage points
  result                    String? // PASS | FAIL
  band                      String? // performance band label
  criticalNotMet            Boolean                  @default(false)
  employeeSubmissionOverdue Boolean                  @default(false)
  managerReviewOverdue      Boolean                  @default(false)
  qaReviewOverdue           Boolean                  @default(false)
  acknowledgedAt            DateTime?
  acknowledgementStatus     String                   @default("NOT_SENT") // NOT_SENT | PENDING | ACKNOWLEDGED
  acknowledgementComment    String?
  employmentEndedDuring     Boolean                  @default(false)
  excludedReason            String?
  prorationFactor           Decimal?                 @db.Decimal(6, 4) // e.g. 0.5 for half-period eligibility
  kpis                      EmployeePerformanceKpi[]
  qaReviews                 PerformanceQaReview[]
  incentive                 PerformanceIncentive?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@unique([cycleId, employeeId])
  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([versionId])
}

model EmployeePerformanceKpi {
  id                      String                        @id @default(uuid())
  companyId               String
  company                 Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assessmentId            String
  assessment              EmployeePerformanceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  kpiDefinitionId         String? // null after template archived; snapshot fields hold the data
  code                    String
  name                    String
  description             String
  categoryLabel           String?
  weight                  Decimal                       @db.Decimal(5, 2)
  measurementType         String
  direction               String
  scoringMethod           String
  targetType              String
  targetValue             Decimal?                      @db.Decimal(18, 4)
  targetText              String?
  unit                    String?
  dataSource              String?
  dataSourceLabel         String?
  critical                Boolean                       @default(false)
  position                Int                           @default(0)
  // values
  actualValue             Decimal?                      @db.Decimal(18, 4)
  actualText              String?
  managerActual           Decimal?                      @db.Decimal(18, 4)
  qaActual                Decimal?                      @db.Decimal(18, 4)
  employeeScore           Decimal?                      @db.Decimal(6, 2)
  achievement             Decimal?                      @db.Decimal(6, 2) // percent 0-100+ (capped)
  capped                  Boolean                       @default(false)
  weightedScore           Decimal?                      @db.Decimal(8, 4) // achievement% x weight / 100 = points
  systemDerived           Boolean                       @default(false)
  employeeComment         String?
  employeeEvidence        String?
  employeeSubmittedAt     DateTime?
  employeeCommentRequired Boolean                       @default(false)
  evidenceRequired        Boolean                       @default(false)
  managerScore            Decimal?                      @db.Decimal(6, 2) // percent achievement entered/adjusted by manager
  managerComment          String?
  managerEvidence         String?
  managerSubmittedAt      DateTime?
  qaScore                 Decimal?                      @db.Decimal(6, 2)
  qaComment               String?
  qaEvidence              String?
  qaSubmittedAt           DateTime?
  effectiveScore          Decimal?                      @db.Decimal(6, 2) // qa ?? manager ?? employee-derived
  auditNotes              String?

  @@index([assessmentId])
  @@index([companyId])
}

model PerformanceQaReview {
  id           String                        @id @default(uuid())
  companyId    String
  company      Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   EmployeePerformanceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  reviewerId   String
  status       String                        @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  comment      String?
  adjustments  Json? // [{kpiId, from, to, reason}]
  submittedAt  DateTime?
  createdAt    DateTime                      @default(now())

  @@index([assessmentId])
  @@index([companyId])
}

model PerformanceNotification {
  id         String    @id @default(uuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String?
  employeeId String?
  type       String
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId, userId])
}

model PerformanceIncentive {
  id              String                        @id @default(uuid())
  companyId       String
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference       String                        @unique
  assessmentId    String                        @unique
  assessment      EmployeePerformanceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId          String?
  plan            IncentivePlan?                @relation(fields: [planId], references: [id])
  planName        String
  finalScore      Decimal                       @db.Decimal(6, 2)
  band            String?
  calculationType String                        @default("PERCENT_SALARY") // FIXED | PERCENT_SALARY | PERCENT_COMMISSION | CUSTOM
  percentValue    Decimal?                      @db.Decimal(6, 4)
  amount          Decimal                       @db.Decimal(18, 2)
  currency        String                        @default("USD")
  status          String                        @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED | SENT_TO_PAYROLL | PAID
  approvedById    String?
  approvedAt      DateTime?
  payrollInputRef String? // reference recorded in payslip data
  paidAt          DateTime?
  rejectionReason String?
