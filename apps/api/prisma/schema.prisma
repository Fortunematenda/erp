// ---------------------------------------------------------------------------
// Integration Control Centre â€” additive models (no existing tables modified).
// All records are company-scoped for multi-tenant isolation.
// ---------------------------------------------------------------------------

// Health history for every adapter health check.
model IntegrationHealthLog {
  id              String   @id @default(uuid())
  companyId       String
  integrationType String // PAYMENT | STORAGE | EMAIL | SMS | QUEUE | ZIMRA | BANK | WEBHOOK
  provider        String
  environment     String   @default("MOCK") // MOCK | TEST | LIVE
  status          String // MOCK | NOT_CONFIGURED | CONFIGURED | CONNECTED | DEGRADED | ERROR | DISABLED
  latencyMs       Int      @default(0)
  message         String?
  details         Json?
  checkedAt       DateTime @default(now())

  @@index([companyId, integrationType, checkedAt])
}

// Structured activity feed (payment created, email sent, object uploaded, ...).
model IntegrationActivityLog {
  id              String   @id @default(uuid())
  companyId       String
  integrationType String
  action          String
  source          String? // API | WEBHOOK | SCHEDULER | MANUAL
  status          String?
  durationMs      Int?
  reference       String?
  correlationId   String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([companyId, integrationType, createdAt])
}

// Webhook events with provider-event idempotency (unique per company+provider+event).
model WebhookEvent {
  id               String    @id @default(uuid())
  companyId        String
  provider         String
  eventId          String
  eventType        String?
  status           String    @default("RECEIVED") // RECEIVED | PROCESSING | PROCESSED | FAILED | IGNORED
  attempts         Int       @default(0)
  signatureValid   Boolean?
  rejectionReason  String?
  payload          Json? // sanitized, permission-controlled
  linkedEntityType String?
  linkedEntityId   String?
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@unique([companyId, provider, eventId])
  @@index([companyId, status, receivedAt])
}

// Outbound messaging log (email / SMS) â€” DELIVERED only when the provider confirms.
model MessageLog {
  id                String   @id @default(uuid())
  companyId         String
  channel           String // EMAIL | SMS
  recipient         String
  template          String?
  source            String? // invoice | reminder | payslip | alert | ...
  subject           String?
  status            String   @default("QUEUED") // QUEUED | SENT | DELIVERED | FAILED
  provider          String
  providerMessageId String?
  correlationId     String?
  errorCode         String?
  errorMessage      String?
  sentById          String?
  createdAt         DateTime @default(now())

  @@index([companyId, channel, createdAt])
}

// Background job queue â€” persists jobs so failed jobs can be retried.
model QueueJob {
  id            String    @id @default(uuid())
  companyId     String
  type          String // EMAIL | FISCAL_RETRY | REPORT | EXPORT | NOTIFICATION | ...
  payload       Json?
  status        String    @default("WAITING") // WAITING | ACTIVE | COMPLETED | FAILED | DELAYED
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  backoffMs     Int       @default(1000)
  errorCode     String?
  errorMessage  String?
  sourceModule  String?
  correlationId String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  nextRetryAt   DateTime?

  @@index([companyId, status, createdAt])
  @@index([companyId, type])
}
