DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexuserp?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Required. Development may use a local example value.
# Production (NODE_ENV=production) will refuse to start if this is missing
# or still set to a known default such as secret / changeme / local-dev-secret.
# Generate a unique secret of at least 16 characters for any shared environment.
JWT_SECRET="change-this-local-secret-before-any-shared-environment"
JWT_EXPIRES_IN="8h"
ZIMRA_MODE="mock"
ZIMRA_TEST_BASE_URL=""
ZIMRA_PRODUCTION_BASE_URL=""
